# Python build & bytecode artifacts
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.eggs/

# Virtual environments
.venv/
venv/
env/

# Test / tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Local runtime data (financial-mcp default cache lives in ~/.cache, but a
# repo-local CACHE_DIR or stray SQLite files should never be committed)
*.db
*.sqlite
*.sqlite3

# Security-toolkit hook runtime logs (written into a repo-local .claude/ when
# the hooks run here during testing; never part of the source)
.claude/hooks/logs/

# Editor / OS noise
.DS_Store
*.swp
.idea/
.vscode/
pii-denylist.local
pii-denylist.txt

# Claude Code sandbox deny-guard placeholders. When a session runs in an
# in-repo worktree, the sandbox materializes zero-byte read-only guard FILES
# at these paths (they shadow user-level config so the session can't write
# it). They are runtime artifacts of the sandbox, never source — without
# these entries a `git add -A` from a worktree sweeps all of them into the
# commit (happened once: 17 empty files reached a PR branch). All patterns
# are root-anchored: an unanchored `.mcp.json` would also ignore the
# plugins' TRACKED per-plugin .mcp.json files.
/.bash_profile
/.bashrc
/.gitconfig
/.gitmodules
/.idea
/.vscode
/.mcp.json
/.profile
/.ripgreprc
/.zprofile
/.zshrc
/.claude/agents/*
# …but deliberate, reviewed dev agents are source (same status as .claude/rules/):
!/.claude/agents/probe-writer.md
/.claude/commands
/.claude/hooks
/.claude/launch.json
/.claude/routines
/.claude/skills
/.claude/worktrees/
